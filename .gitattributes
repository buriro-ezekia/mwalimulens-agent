# Consistent Git line endings across Windows, Linux and macOS.
# Explicitly preserve LF for Python and repository text files even when
# a contributor has core.autocrlf=true. Binary files remain untouched.
* text=auto

/.gitattributes text eol=lf
/.editorconfig text eol=lf
*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.html text eol=lf
